{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "max",
      "textVerbosity": "low",
      "prompt": "{file:./.opencode/prompts/plan.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "spec/plan/**": "allow"
        },
        "bash": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout": "allow"
        },
        "skill": {
          "*": "deny",
          "plan-execute-workflow": "allow"
        }
      }
    },
    "build": {
      "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout": "allow"
        }
      }
    },
    "general": {
      "disable": true
    },
    "explore": {
      "mode": "subagent",
      "model": "stepfun/step-3.7-flash",
      "reasoningEffort": "low"
    },
    "scout": {
      "mode": "subagent",
      "model": "stepfun/step-3.7-flash",
      "reasoningEffort": "low"
    }
  }
}
